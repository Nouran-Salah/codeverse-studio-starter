# Copy to .env (or export) to configure Codeverse Studio.

# "deterministic" (default, no model needed) or "ollama"
CODEVERSE_PROVIDER=deterministic

# Ollama settings (used when CODEVERSE_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
CODEVERSE_LLM_TIMEOUT=60
CODEVERSE_LLM_RETRIES=2

# Quality gate
CODEVERSE_MAX_REVISIONS=2
CODEVERSE_APPROVAL_THRESHOLD=80
